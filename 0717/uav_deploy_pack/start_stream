#!/bin/bash
# =====================================================================
#   Kneo Pi (KL730) One-Touch Adaptive SRT Streaming Launcher
#   Usage:
#     ./start_stream                 # Auto-adaptive IP discovery + auto video source
#     ./start_stream --usb           # Stream from USB camera port (/dev/video*)
#     ./start_stream --mipi          # Stream from MIPI CSI camera port (/dev/video0)
#     ./start_stream --file          # Stream from H.264 video file (/tmp/uav_test_720p.h264)
#     ./start_stream 192.168.168.17  # Manual Ground Station IP override
# =====================================================================

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$REAL_PATH")" && pwd)"

DAEMON_SCRIPT=""
if [ -f "$PROJECT_ROOT/0717/uav_deploy_pack/uav_daemon.py" ]; then
    DAEMON_SCRIPT="$PROJECT_ROOT/0717/uav_deploy_pack/uav_daemon.py"
elif [ -f "$PROJECT_ROOT/bin/uav_daemon.py" ]; then
    DAEMON_SCRIPT="$PROJECT_ROOT/bin/uav_daemon.py"
fi

if [ -z "$DAEMON_SCRIPT" ]; then
    echo "[Error] Could not locate uav_daemon.py under $PROJECT_ROOT"
    exit 1
fi

echo "=================================================="
echo "  🚀 Kneo Pi (KL730) One-Touch Streaming System"
echo "  Auto-Discovery & Adaptive SRT Connection"
echo "=================================================="

# 1. Clean up old zombie processes to free VPU CMA memory & camera nodes
echo "[Launcher] Cleaning up stale encoder and daemon processes..."
pkill -9 -f uav_daemon.py 2>/dev/null
pkill -9 -f venc1 2>/dev/null
pkill -9 -f example_nnm_sensor 2>/dev/null
pkill -9 -f "ffmpeg.*v4l2" 2>/dev/null
sleep 0.5


# 2. Check/Generate H.264 test video stream if needed
TEST_VIDEO="/tmp/uav_test_720p.h264"
MP4_SOURCE=""

for candidate in \
    "$PROJECT_ROOT/0717/uav_deploy_pack/test_video/模擬空拍機1080p_h264.mp4" \
    "$PROJECT_ROOT/0717/uav_deploy_pack/test_video/old_town_cross.mp4" \
    "$PROJECT_ROOT/bin/test_video/模擬空拍機1080p_h264.mp4"; do
    if [ -f "$candidate" ]; then
        MP4_SOURCE="$candidate"
        break
    fi
done

if [ ! -f "$TEST_VIDEO" ] || [ ! -s "$TEST_VIDEO" ]; then
    if [ -n "$MP4_SOURCE" ]; then
        echo "[Launcher] Preparing H.264 test stream file: $TEST_VIDEO..."
        ffmpeg -y -i "$MP4_SOURCE" -t 60 -vf scale=1280:720 -c:v libx264 -preset ultrafast -bf 0 -g 10 -pix_fmt yuv420p "$TEST_VIDEO" >/dev/null 2>&1
        echo "[Launcher] Test video ready."
    fi
fi

# 3. Launch adaptive daemon with CLI arguments
echo "[Launcher] Starting UAV Auto-Discovery Daemon..."
exec python3 "$DAEMON_SCRIPT" "$@"
