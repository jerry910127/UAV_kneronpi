{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug example_nnm_webcam",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/example_nnm_webcam",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
// ,     "preLaunchTask": "build example_nnm_webcam debug"
    }
  ]
}