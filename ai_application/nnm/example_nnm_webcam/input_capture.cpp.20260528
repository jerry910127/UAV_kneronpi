#include "h26xenc_api.h"

#include <sync_shared_memory.h>
#include <ssm_info.h>

#define CAM_WIDTH	640
#define CAM_HEIGHT	480

extern char *g_szSsmReaderPin;

extern SSM_WRITER_INIT_OPTION_T ssm_opt;
extern SSM_HANDLE_T* g_ptSsmWriterHandle;

void ssm_clear_header(unsigned char* virt_addr, unsigned int buf_size, void* pUserData);
#endif

extern bool _blDispatchRunning;
extern bool _blFifoqManagerRunning;

extern bool _blSendInfRunning;
extern bool _blResultRunning;
extern bool _blDisplayRunning;

bool _blImageRunning = true;

NNM_SHARED_INPUT_T _input_data = {0};
pthread_mutex_t _mutex_image = PTHREAD_MUTEX_INITIALIZER;

// --- Y16 (16-bit) capture sharing between input thread and display thread ---
std::atomic<bool> g_capture_y16(true);
pthread_mutex_t g_mutex_raw16 = PTHREAD_MUTEX_INITIALIZER;
cv::Mat g_raw16_latest;   // CV_16UC1
bool g_raw16_valid = false;


void *example_webcam_input_thread(void *arg)
{
    EXAMPLE_WEBCAM_INIT_OPT_T* pInitOpt=(EXAMPLE_WEBCAM_INIT_OPT_T*)arg;

    cv::VideoCapture cv_camera_cap;
    cv::Mat cv_read_camera, cv_img_to_be_sent;

    // --- runtime toggle (8-bit <-> Y16) ---
    // NOTE: must be declared before any goto labels to avoid "crosses initialization" errors.
    bool cur_y16 = g_capture_y16.load();

    // Used for camera read error recovery. Must be declared before any goto as well.
    int consecutive_read_fail = 0;

#ifdef H26XE_API_H
    SSM_BUFFER_T tWriterSsmBuffer;
    std::vector<unsigned char> yuv_data;

    VMF_VSRC_SSM_OUTPUT_INFO_T vsrc_ssm_writer_info;

    vsrc_ssm_writer_info.dwYStride = CAM_WIDTH;
    vsrc_ssm_writer_info.dwYSize = vsrc_ssm_writer_info.dwYStride * CAM_HEIGHT;
    vsrc_ssm_writer_info.dwUVSize = vsrc_ssm_writer_info.dwYSize >> 2;
    vsrc_ssm_writer_info.dwOffset[0] = VMF_MAX_SSM_HEADER_SIZE;
    vsrc_ssm_writer_info.dwOffset[1] = vsrc_ssm_writer_info.dwOffset[0] + vsrc_ssm_writer_info.dwYSize;
    vsrc_ssm_writer_info.dwOffset[2] = vsrc_ssm_writer_info.dwOffset[1] + vsrc_ssm_writer_info.dwUVSize;
    vsrc_ssm_writer_info.dwWidth = CAM_WIDTH;
    vsrc_ssm_writer_info.dwHeight = CAM_HEIGHT;

    memset(&ssm_opt, 0, sizeof(SSM_WRITER_INIT_OPTION_T));
    ssm_opt.name = g_szSsmReaderPin;
    ssm_opt.buf_size = (CAM_WIDTH * CAM_HEIGHT * 2) + VMF_MAX_SSM_HEADER_SIZE;
    ssm_opt.alignment = VMF_ALIGN_TYPE_DEFAULT;
    ssm_opt.pUserData = &vsrc_ssm_writer_info;
    ssm_opt.fp_setup_buffer = ssm_clear_header;
    g_ptSsmWriterHandle = SSM_Writer_Init(&ssm_opt);
    if (!g_ptSsmWriterHandle)
    {
        printf("init g_ptSsmWriterHandle failed\n");
    }
#endif

    auto reopen_camera = [&](bool want_y16) -> bool {
        cv_camera_cap.release();

        if (false == cv_camera_cap.open(pInitOpt->pszCameraPath)) {
            printf("[%s] open/reopen camera failed %s\n", __FUNCTION__, pInitOpt->pszCameraPath);
            return false;
        }

        /* Setting frame size may fail in OpenCV; still try */
        cv_camera_cap.set(cv::CAP_PROP_FRAME_WIDTH, pInitOpt->dwImageWidth);
        cv_camera_cap.set(cv::CAP_PROP_FRAME_HEIGHT, pInitOpt->dwImageHeight);
        cv_camera_cap.set(cv::CAP_PROP_FPS, pInitOpt->dwFps);

        if (want_y16) { 
            // Try to request V4L2 Y16 (not supported by every camera/driver)
            cv_camera_cap.set(cv::CAP_PROP_CONVERT_RGB, 0);
            cv_camera_cap.set(cv::CAP_PROP_FOURCC, cv::VideoWriter::fourcc('Y','1','6',' '));
        } else {
            cv_camera_cap.set(cv::CAP_PROP_CONVERT_RGB, 1);
        }

        // Update actual size after opening
        pInitOpt->dwImageWidth = (unsigned int)cv_camera_cap.get(cv::CAP_PROP_FRAME_WIDTH);
        pInitOpt->dwImageHeight = (unsigned int)cv_camera_cap.get(cv::CAP_PROP_FRAME_HEIGHT);
        return true;
    };

    // Initial open with current mode
    if (!reopen_camera(cur_y16)) {
        goto EXIT_FREAD_IMAGE_THREAD;
    }

    while (true == _blImageRunning)
    {
        // Check if display thread requested switching capture mode
        bool want_y16 = g_capture_y16.load();
        if (want_y16 != cur_y16) {
            if (reopen_camera(want_y16)) {
                cur_y16 = want_y16;
            } else {
                // revert request if reopen failed
                g_capture_y16.store(cur_y16);
            }

            pthread_mutex_lock(&g_mutex_raw16);
            g_raw16_latest.release();
            g_raw16_valid = false;
            pthread_mutex_unlock(&g_mutex_raw16);
        }

        if (!cv_camera_cap.read(cv_read_camera) || cv_read_camera.empty()) {
            consecutive_read_fail++;
            if (consecutive_read_fail >= 10) {
                // try reopen current mode
                reopen_camera(cur_y16);
                consecutive_read_fail = 0;
            }
            usleep(20000);
            continue;
        }
        consecutive_read_fail = 0;

        // Prepare a BGR image for downstream (display/inference)
        cv::Mat bgr;

        if (cur_y16) {
            // Try to interpret the grabbed frame as 16-bit grayscale
            cv::Mat y16;

            if (cv_read_camera.type() == CV_16UC1) {
                y16 = cv_read_camera;
            } else if (cv_read_camera.type() == CV_8UC2) {
                // Many drivers deliver Y16 as two 8-bit channels; wrap it as 16UC1
                y16 = cv::Mat(cv_read_camera.rows, cv_read_camera.cols, CV_16UC1, cv_read_camera.data);
            } else if (cv_read_camera.type() == CV_8UC1 &&
                       cv_read_camera.step == (size_t)cv_read_camera.cols * 2) {
                // Some drivers deliver as 8UC1 with 2 bytes per pixel (step == cols*2)
                y16 = cv::Mat(cv_read_camera.rows, cv_read_camera.cols, CV_16UC1, cv_read_camera.data);
            }
//RWEI mmlab 04/10
            cv::Mat y16_crop = y16.rowRange(5, y16.rows-5).colRange(5, y16.cols - 5); //rwei mmlab 4/10
            y16 = y16_crop.clone();
//RWEI mmlab 04/10 end
            if (!y16.empty()) {
                // Share raw16 for monitoring
                pthread_mutex_lock(&g_mutex_raw16);
                g_raw16_latest = y16.clone();
                g_raw16_valid = true;
                pthread_mutex_unlock(&g_mutex_raw16);










                
                // Generate an 8-bit preview/inference input (simple >>8 mapping)
                cv::Mat gray8;
                y16.convertTo(gray8, CV_8U, 1.0 / 256.0);

//rwei mmlab 4/1

                // // 1. 計算影像的平均值與標準差
                // cv::Scalar mean_val, stddev_val;
                // cv::meanStdDev(y16, mean_val, stddev_val);

                // // 2. 設定動態範圍 (例如：平均值 ± 3倍標準差)
                // double min_rad = mean_val[0] - 3.0 * stddev_val[0];
                // double max_rad = mean_val[0] + 3.0 * stddev_val[0];
                // printf("Mean_value:%f   ",mean_val[0]);
                // printf("Stddev_val:%f \n",stddev_val[0]);
                // // 3. 防呆機制：避免畫面全平坦時除以零
                // if (max_rad <= min_rad) {
                //     max_rad = min_rad + 1.0;
                // }

                // // 4. 計算 alpha (Gain) 和 beta (Offset)
                // double alpha = 255.0 / (max_rad - min_rad);
                // double beta = -min_rad * alpha;

                // // 5. 套用轉換
                // y16.convertTo(gray8, CV_8U, alpha, beta);

//rwei mmlab 4/1 END
//Rwei mmlab 4/1 用於測試
/*
                if (y16.type() == CV_16UC1 && !y16.empty()) {
                    int cy = y16.rows / 2; // 計算中間的 Y 軸 (Row)
                    int cx = y16.cols / 2; // 計算中間的 X 軸 (Col)

                    // 取得中間那一行的記憶體指標
                    const uint16_t* p = y16.ptr<uint16_t>(cy);

                    // 設定要查看的範圍：以中心點為準，左右各取 2 個像素 (共 5 個)
                    int start_x = std::max<int>(0, cx - 2);
                    int end_x = std::min<int>(y16.cols - 1, cx + 2);

                    std::cout << "Center pixels (Row: " << cy << "):" << std::endl;
                    for (int x = start_x; x <= end_x; x++) {
                        std::cout << "pixel[" << cy << ", " << x << "] = " << p[x] << std::endl;
                    }
                }
                std::cout << "rows      = " << y16.rows << "    ";
                std::cout << "cols      = " << y16.cols << "    ";
                std::cout << "channels  = " << y16.channels() << "    ";
                std::cout << "depth     = " << y16.depth() << "    ";
                std::cout << "type      = " << y16.type() << "    ";
                std::cout << "elemSize  = " << y16.elemSize() << " bytes" << "    ";
                std::cout << "elemSize1 = " << y16.elemSize1() << " bytes" << "    ";
                std::cout << "step      = " << y16.step << " bytes per row" << "    ";
                std::cout << "total     = " << y16.total() << " elements" << "    ";
                std::cout << "isContinuous = " << y16.isContinuous() << std::endl;


                if (gray8.type() == CV_8U && !gray8.empty()) {
                    int cy = gray8.rows / 2; // 計算中間的 Y 軸 (Row)
                    int cx = gray8.cols / 2; // 計算中間的 X 軸 (Col)

                    // 取得中間那一行的記憶體指標
                    const uint8_t* p = gray8.ptr<uint8_t>(cy);

                    // 設定要查看的範圍：以中心點為準，左右各取 2 個像素 (共 5 個)
                    int start_x = std::max<int>(0, cx - 2);
                    int end_x = std::min<int>(gray8.cols - 1, cx + 2);

                    std::cout << "Center pixels (Row: " << cy << "):" << std::endl;
                    for (int x = start_x; x <= end_x; x++) {
                        std::cout << "pixel[" << cy << ", " << x << "] = " << static_cast<int>(p[x]) << std::endl;
                    }
                }
                std::cout << "rows      = " << gray8.rows << "    ";
                std::cout << "cols      = " << gray8.cols << "    ";
                std::cout << "channels  = " << gray8.channels() << "    ";
                std::cout << "depth     = " << gray8.depth() << "    ";
                std::cout << "type      = " << gray8.type() << "    ";
                std::cout << "elemSize  = " << gray8.elemSize() << " bytes" << "    ";
                std::cout << "elemSize1 = " << gray8.elemSize1() << " bytes" << "    ";
                std::cout << "step      = " << gray8.step << " bytes per row" << "    ";
                std::cout << "total     = " << gray8.total() << " elements" << "    ";
                std::cout << "isContinuous = " << gray8.isContinuous() << std::endl;
                */
//Rwei mmlab 4/1 END 
//derek mmlab 4/7
// 2. 攤平影像並計算全畫面中前 2% 的高溫平均值
    cv::Mat flat;
    y16.reshape(1, 1).copyTo(flat); // 攤平成 1D (1 x N) 的陣列

    // 由小到大排序 (數值越大代表溫度越高，會被排在陣列最後面)
    cv::sort(flat, flat, cv::SORT_EVERY_ROW + cv::SORT_ASCENDING); 

    int total_pixels = flat.cols; 
    int top2_count = total_pixels * 0.02; // 計算 2% 佔了多少個像素點

    // 使用 colRange 取出陣列的最後 2% (也就是數值最大的前 2% 高溫群)
//    cv::Mat top2_percent_mat = flat.colRange(total_pixels - top2_count, total_pixels);
    cv::Mat top2_percent_mat = flat.colRange(1, top2_count);
    // 計算這前 2% 陣列的平均值
    cv::Scalar top2_mean = cv::mean(top2_percent_mat);
    
    // 將計算出來的平均值存入顯示變數
    // (如果之後實作了 Radiometry 絕對溫度轉換公式，可以直接在這裡把 top2_mean[0] 代入計算)
    float display_val = top2_mean[0];

    // 3. 將文字繪製到準備送出顯示的 BGR 畫面上
    char text[64];
    sprintf(text, "Top 2%% Avg: %.1f", display_val);
    printf("Top 2%% Avg: %.1f \n", display_val);
    // 在畫面的左上角顯示紅色字體 (B=0, G=0, R=255)
    cv::putText(bgr, text, cv::Point(30, 50),
                cv::FONT_HERSHEY_SIMPLEX, 1.0, cv::Scalar(0, 0, 255), 2);
//derek mmlab 4/7 end
                cv::cvtColor(gray8, bgr, cv::COLOR_GRAY2BGR);
            } else {
                pthread_mutex_lock(&g_mutex_raw16);
                g_raw16_valid = false;
                pthread_mutex_unlock(&g_mutex_raw16);
            }
        } else {
            // 8-bit mode: clear raw16 valid
            pthread_mutex_lock(&g_mutex_raw16);
            g_raw16_valid = false;
            std::cout<<"raw16"<<g_raw16_valid<<std::endl;//mmlab114 3/27
            pthread_mutex_unlock(&g_mutex_raw16);
        }

        // If we still don't have a BGR image, convert from what OpenCV gave us
        if (bgr.empty()) {
            if (cv_read_camera.channels() == 3) {
                bgr = cv_read_camera;
            } else if (cv_read_camera.channels() == 4) {
                cv::cvtColor(cv_read_camera, bgr, cv::COLOR_BGRA2BGR);
            } else if (cv_read_camera.channels() == 1) {
                cv::cvtColor(cv_read_camera, bgr, cv::COLOR_GRAY2BGR);
            } else {
                // Fallback: just skip this frame
                continue;
            }
        }
        pthread_mutex_lock(&_mutex_image);
        cv::cvtColor(bgr, cv_img_to_be_sent, cv::COLOR_BGR2RGBA);

        _input_data.input_buf_address = (uintptr_t)cv_img_to_be_sent.data;
        _input_data.input_image_width = cv_img_to_be_sent.cols;
        _input_data.input_image_height = cv_img_to_be_sent.rows;
        _input_data.input_image_format = KP_IMAGE_FORMAT_RGBA8888;

        _input_data.input_buf_size = _input_data.input_image_width * _input_data.input_image_height * 4;
        _input_data.input_ready_inf = true;
#ifdef H26XE_API_H
        // Only request the shared-memory buffer when we are sure we will write a frame
        SSM_Writer_SendGetBuff(g_ptSsmWriterHandle, &tWriterSsmBuffer);
        bgrToYUV420(bgr, yuv_data);

        memcpy(tWriterSsmBuffer.buffer + VMF_MAX_SSM_HEADER_SIZE, yuv_data.data(), yuv_data.size());
        MemBroker_CacheFlush(tWriterSsmBuffer.buffer + VMF_MAX_SSM_HEADER_SIZE, yuv_data.size());
#endif
        pthread_mutex_unlock(&_mutex_image);
    }

EXIT_FREAD_IMAGE_THREAD:

#ifdef H26XE_API_H
    if (g_ptSsmWriterHandle) {
        SSM_Writer_SendGetBuff(g_ptSsmWriterHandle, &tWriterSsmBuffer);
        SSM_Release(g_ptSsmWriterHandle);
        g_ptSsmWriterHandle = NULL;
    }
#endif

    _blSendInfRunning = false;
    _blResultRunning = false;
    _blDisplayRunning = false;

    _blDispatchRunning = false;
    _blFifoqManagerRunning = false;

    printf("[%s] bye!\r\n", __func__);
    return NULL;
}
